# Server Configuration
PORT=5001
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/assignmentghar?schema=public"

# CORS and Socket.IO Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:5001

# Authentication & Admin
JWT_SECRET="your-secure-jwt-secret"
ADMIN_EMAIL="admin@speedassignment.com"
ADMIN_PASSWORD="YourSecurePasswordHere!"

